RewriteEngine On

# Redirect all requests to public directory (except babyloncc/dist)
RewriteCond %{REQUEST_URI} !^/animMIDI/babyloncc/dist/
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ /public/$1 [L]

# Prevent access to sensitive files
<FilesMatch "\.(env|json|lock|xml|md)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Prevent directory listing
Options -Indexes